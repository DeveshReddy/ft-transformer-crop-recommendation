# Copy this file to .env and fill in your keys:
#   cp .env.example .env
#
# OpenWeatherMap (for live weather in inference)
# Get a key: https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# Kaggle (for auto-downloading the dataset when running train.py)
# Get credentials: Kaggle → Settings → API → Create New Token (downloads kaggle.json)
# Either put kaggle.json in ~/.kaggle/ OR set these two variables in .env:
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key
